# =====================================================================
# DevPilot 环境变量样例。复制为 .env 后按需修改；.env 已被 git 忽略，
# 严禁把真实密钥提交进仓库。
# =====================================================================

# ---------- Java 后端 (Spring Boot, backend/src/main/resources/application.yml) ----------
SERVER_PORT=8080
# 生产必须使用 ≥32 字节的强随机密钥
JWT_SECRET=dev-only-secret-key-please-override-in-prod-0123456789
JWT_EXPIRE_MINUTES=120

# MySQL（Compose 内使用容器主机名 mysql；本机开发可用 127.0.0.1:3307）
DB_URL=jdbc:mysql://mysql:3306/devpilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=devpilot
DB_PASSWORD=devpilot123

# Redis（可选；不可用时后端自动降级为进程内实现）
REDIS_HOST=redis
REDIS_PORT=6379

# 首次启动创建的管理员账号（生产必须覆盖密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod

# 上传与索引产物存储目录
STORAGE_PATH=/app/data/storage

# Python AI 服务地址与内部调用 Token（两服务必须一致）
AI_SERVICE_BASE_URL=http://ai-service:8200
INTERNAL_TOKEN=change-me-to-a-long-random-string

# 前端跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# ---------- Python AI 服务 (ai-service/app/config.py) ----------
# LLM Provider: mock（离线演示，输出明确标注）| openai（OpenAI 兼容 API）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Embedding Provider: hashing（本地降级实现）| openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

AI_DATA_DIR=/app/data/index-store

# ---------- MySQL 容器初始化 ----------
MYSQL_ROOT_PASSWORD=root-please-change
MYSQL_DATABASE=devpilot
MYSQL_USER=devpilot
MYSQL_PASSWORD=devpilot123
